{
  "name": "spanish-elections-2026",
  "version": "0.1.0",
  "private": true,
  "description": "Independent, factual voter-information tool for Spain's general election of 29 November 2026",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "votes": "node scripts/fetch_votes.mjs",
    "build": "node scripts/validate.mjs --strict && node scripts/build.mjs",
    "check-sources": "node scripts/check_sources.mjs",
    "serve": "python3 -m http.server -d site 8000",
    "test:browser": "node tests/browser/questionnaire.cjs"
  }
}
